<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sobe a Api em memória (WebApplicationFactory) e exercita o endpoint por HTTP, com banco e cache
    em container. Cada endpoint testa o caminho happy e pelo menos um de erro.
  -->
  <!--
    A Infrastructure é referenciada explicitamente, e não só através da Api: estes testes semeiam dados pelo
    AppDbContext (ver IdentityGatewayApiFactory.ComEscopoAsync), então o tipo é usado no código daqui.

    Depender da referência transitiva pela Api compila enquanto a Api mantiver a mesma cadeia de pacotes — e
    quebra no dia em que ela mudar, com um CS0234 que parece não ter relação com a alteração feita.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\IdentityGateway.Api\IdentityGateway.Api.csproj" />
    <ProjectReference Include="..\..\src\IdentityGateway.Infrastructure\IdentityGateway.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\IdentityGateway.Domain\IdentityGateway.Domain.csproj" />

    <!-- O fixture do Keycloak e o harness de login: a mesma biblioteca que os testes de integração usam. -->
    <ProjectReference Include="..\IdentityGateway.Testing.Keycloak\IdentityGateway.Testing.Keycloak.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Bogus" />

    <!--
      Usados direto nos testes: o pacote base para DbContext e ToListAsync; o Relational para MigrateAsync,
      que é método de extensão dele e não do base.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />

    <!--
      Usados direto no código dos testes: as opções do JwtBearer (conferidas em execução) e o sink em memória do
      Serilog. Vêm transitivos pela Api, mas dependência usada no código é dependência declarada.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />

    <!--
      BaseExporter e SimpleActivityExportProcessor, para o teste de vazamento ver os spans que a Api exportaria.
      Vem transitivo pela Api; declarado porque é usado no código.
    -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

</Project>
