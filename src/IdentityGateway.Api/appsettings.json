{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "EnableSensitiveDataLogging": false
  },
  "Redis": {
    "DefaultExpirationSeconds": 300,
    "InstanceName": "identitygateway:"
  },
  "Jwt": {
    "Issuer": "identitygateway",
    "Audience": "identitygateway-api",
    "ExpirationMinutes": 60
  },
  "HttpResilience": {
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 1,
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 30,
    "FailureRatio": 0.5,
    "BreakDurationSeconds": 30
  },
  "Keycloak": {
    "Admin": {
      "Realm": "identity-gateway",
      "ClientId": "identity-gateway"
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "BaseRetryDelaySeconds": 10,
    "MaxRetryDelaySeconds": 300,
    "ProcessedRetentionHours": 72,
    "CleanupEveryCycles": 60
  },
  "Plans": {
    "free":       { "tier": "Free",       "maxUsers": 5,   "maxClients": 1 },
    "standard":   { "tier": "Standard",   "maxUsers": 50,  "maxClients": 5 },
    "enterprise": { "tier": "Enterprise", "maxUsers": 500, "maxClients": 50 }
  }
}
