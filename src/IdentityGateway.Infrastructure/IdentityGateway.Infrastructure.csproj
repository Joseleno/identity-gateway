<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure → Domain + Application (só implementa as interfaces que a Application declara). -->
  <ItemGroup>
    <ProjectReference Include="..\IdentityGateway.Domain\IdentityGateway.Domain.csproj" />
    <ProjectReference Include="..\IdentityGateway.Application\IdentityGateway.Application.csproj" />
  </ItemGroup>

  <!--
    O EF Core vive aqui e só aqui. Há regra de arquitetura garantindo que ele não alcance o Domain nem a
    Application: persistência é detalhe, e o domínio não sabe que existe banco.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!-- Configuração validada no startup, e o cache de dois níveis. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

  <!--
    Keycloak (Identity/Keycloak): o client assertion do private_key_jwt é montado com o mesmo stack de JWT que a
    Api usa para validar tokens; a resiliência é a do .NET 10 (Polly v8 por baixo); o health check do Keycloak
    mora aqui porque depende do cache do token, que é interno a esta camada.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <!--
    Ferramenta de linha de comando (dotnet ef), com PrivateAssets: é usada para gerar migration em
    desenvolvimento e não deve vazar como dependência para quem consumir este assembly.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Os interceptors, os DbSet e a OutboxMessage são internal de propósito: ninguém fora desta camada deveria
    alcançá-los. O projeto de teste é a exceção — ele precisa instanciar os interceptors para exercitá-los.
    Tornar os tipos públicos para satisfazer o teste é o caminho errado: abriria para a Api também.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="IdentityGateway.Infrastructure.IntegrationTests" />

    <!--
      Os testes funcionais também: eles preparam estado e conferem o que foi persistido pelo DbContext, em vez
      de por SQL cru — assim o teste depende do modelo, e um mapeamento errado quebra ali em vez de passar
      despercebido. Continuam fechados para a Api e para qualquer consumidor externo.
    -->
    <InternalsVisibleTo Include="IdentityGateway.Api.FunctionalTests" />
  </ItemGroup>

</Project>
